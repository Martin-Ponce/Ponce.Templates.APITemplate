{
  "AllowedHosts": "*",
  "DatabaseConnections": {
    "Database": {
      "ConnectionString": "Server=ServerName;Initial Catalog=DatabaseName;User Id=User;Password=Password;Trusted_Connection=False;Encrypt=False;TrustServerCertificate=True;",
      "Provider": "SqlServer"
    }
  },
  "Logger": {
    "LogHttpRequests": false,
    "Database": {
      "Enabled": false,
      "MinimumLevel": "Error"
    }
  },
  "Telemetry": {
    "Enabled": false,
    "TracesDestination": "http://localhost:4318/v1/traces",
    "LogsDestination": "http://localhost:3100",
    "LogsMinimumLevel": "Error"
  },
  "MaxCallsPerMinute": 100,
  "Cache": {
    "Enabled": false,
    "SlidingExpirationInMinutes": 15,
    "AbsoluteExpirationInMinutes": 60
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ],
    "Headers": [
      "X-Pagination"
    ]
  }
}
